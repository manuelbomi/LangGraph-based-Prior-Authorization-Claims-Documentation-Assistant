# Copy this file to `.env` (repo root, and/or `backend/.env`) and fill in
# real values. NEVER commit your actual `.env` file (it's git-ignored).

# --- LLM provider ------------------------------------------------------
# "openai" (default, tested) or "anthropic"
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-3-5-haiku-latest
OPENAI_API_KEY=sk-your-openai-key-here
ANTHROPIC_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
LLM_TEMPERATURE=0.0

# --- Postgres (prompts, patients/PA-request history, LangGraph checkpoints) -
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=prior_auth
# Local dev (no Docker): localhost. Inside docker-compose: host "postgres".
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/prior_auth

# --- Documents -------------------------------------------------------------
# Where uploaded chart excerpts are stored (git-ignored).
UPLOAD_DIR=./data/uploads
# Where the bundled synthetic sample referrals / payer policies / patient
# records live. Local dev: one level up from backend/. Docker: mounted
# read-only at /app/sample-data.
SAMPLE_DATA_DIR=../sample-data

# --- Milvus Lite (embedded payer-policy-criteria semantic search, no server/docker needed) -
MILVUS_LITE_PATH=./data/milvus_policy_criteria.db
MILVUS_COLLECTION=payer_policy_criteria
POLICY_SEARCH_TOP_K=6

# --- API / CORS ----------------------------------------------------------
CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Frontend --------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000
